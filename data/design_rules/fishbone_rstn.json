{
  "version": 1,
  "sources": [
    {
      "url": "https://blog.se.com/infrastructure-and-grid/power-management-metering-monitoring-power-quality/2018/06/06/clearances-and-creepage-distances-in-lv-electrical-switchboards/",
      "rule": "Clearance depends on Uimp; creepage depends on Ui, pollution degree and material group. Verify after short-circuit withstand testing."
    },
    {
      "url": "https://www.electrical-installation.org/enwiki/Sizing_the_neutral_conductor",
      "rule": "Size neutral for imbalance and triplen harmonics; do not automatically reduce neutral cross-section."
    },
    {
      "url": "https://www.ls-electric.com/upload/customer/download/1483/150905_MCB_E.pdf",
      "rule": "BKN uses 35 mm DIN rail and 17.8 mm nominal width per pole. Rotation, terminal positions and installation clearances require the exact model manual."
    },
    {
      "url": "https://www.se.com/uk/en/faqs/FAQ000271969/",
      "rule": "Handle and LOTO projection must fit the gap behind doors."
    },
    {
      "url": "https://latrivenetacavi.nexans.com/en/products/industrial-and-logistics/industrial-Eca-class/H07V-R38469/product~015041105~.html",
      "rule": "H07V-R 1x150 example: recommended bend radius 6 times cable diameter; do not generalize to every cable."
    }
  ],
  "layout_assumptions_mm": {
    "spine_pitch": 30,
    "neutral_review_width": 10,
    "routing_port_standoff": 8,
    "branch_side_margin": 90
  },
  "neutral": {
    "topology": "separate_N_spine_with_fishbone_branches",
    "source": "incoming_neutral_not_3P_MCCB",
    "colour_role": "N_label_required_colour_is_not_identification",
    "connect_PE": false,
    "three_pole_branch": "route_to_separate_load_neutral_terminal_if_required",
    "two_pole_branch": "neutral_pole_requires_terminal_map",
    "rcd": "downstream_neutrals_must_not_be_shared_between_RCD_circuits"
  },
  "required_before_release": [
    "Ui",
    "Uimp",
    "pollution_degree",
    "material_group",
    "busbar_width_thickness",
    "short_circuit_current_duration",
    "support_spacing",
    "temperature_rise",
    "terminal_map",
    "mounting_orientation",
    "neutral_load_harmonics"
  ],
  "clearance_compliance": "unknown_until_required_inputs_verified",
  "form_faces": {
    "1st DOOR VIEW": "outer_door",
    "2nd DOOR VIEW": "inner_door",
    "EQUIPMENT VIEW": "mounting_plate",
    "SIDE VIEW": "side",
    "default_operator_devices_face": "outer_door",
    "override_field": "cad.mounting_face",
    "side_view_requires": [
      "device_side_geometry",
      "mounting_offsets",
      "cable_bend_radius",
      "busbar_depth_layers"
    ],
    "unknown_face": "block_placement"
  },
  "user_design_policy": {
    "basis": "user_project_rules_not_claimed_IEC_minima",
    "top_gap_mm": [
      {
        "min_a": 100,
        "max_a_exclusive": 200,
        "gap": 150
      },
      {
        "min_a": 200,
        "max_a_exclusive": 300,
        "gap": 300,
        "allowed_range": [
          250,
          300
        ]
      },
      {
        "min_a": 300,
        "gap": 400
      }
    ],
    "boundary_policy": "200A uses 300mm; 300A uses 400mm; below100A requires manual rule",
    "fishbone_max_main_a": 250,
    "branch_to_busbar_edge_min_mm": 30,
    "branch_to_busbar_edge_target_mm": 40,
    "side_to_shell_mm": {
      "above200A": 150,
      "up_to200A": 110,
      "strict_min_up_to200A": 100
    },
    "busbar_section": "select by current, temperature, short circuit and supports; no section inferred from photo",
    "collision_check": [
      "closed_door_back_projection",
      "handle_swept_envelope",
      "LOTO_projection",
      "terminal_lug_envelope",
      "cable_bend_envelope"
    ],
    "unknown_depth_geometry": "block_fabrication_release"
  }
}