PROJECT_NAME=BE_BOM - Hệ Thống Bóc Tách & Dự Toán Tủ Bảng Điện
VERSION=0.1.0
DEBUG=true

# Database (Mặc định dùng SQLite có sẵn: webbaogia.db)
DATABASE_URL=sqlite+aiosqlite:///./webbaogia.db
# Hoặc nếu dùng PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://db_user:db_password@localhost:5432/db_name
DB_ECHO=false

# Security
SECRET_KEY=aide-secret-key-change-in-production-random-hash
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 ngày (7 * 24 * 60 phút)
REFRESH_TOKEN_EXPIRE_DAYS=30

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000","*"]

# AI Providers (configured via Admin panel)
DEFAULT_AI_PROVIDER=gemini
AI_CONNECTION_TEST_PROMPT=Xin chào! Hãy xác nhận kết nối bằng tiếng Việt ngắn gọn trong 1 câu: 1+1 bằng mấy?
AI_COMPATIBLE_DEFAULT_BASE_URL=https://api.openai.com/v1

# File Storage
UPLOAD_DIR=storage/uploads
MAX_FILE_SIZE_MB=50

# Quotation & Engineering Defaults
DEFAULT_VAT_RATE=0.08
DEFAULT_LABOR_HOURLY_RATE=150000.0
PROTECTION_SIMULTANEITY_FACTOR=0.8

# Labor Estimation Rates (giờ công / đơn vị)
LABOR_RATE_SHEET_METAL_H_PER_M2=2.5
LABOR_RATE_MOUNTING_H_PER_DEVICE=0.4
LABOR_RATE_BUSBAR_H_PER_KG=0.8
LABOR_RATE_WIRING_H_PER_DEVICE=0.5
LABOR_RATE_TESTING_H_PER_DEVICE=0.2
LABOR_TESTING_BASE_HOURS=4.0
WORK_HOURS_PER_DAY=8.0

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# SePay VietQR Payment Configuration
# Lấy API Key tại: https://my.sepay.vn (Cấu hình Webhook)
SEPAY_API_KEY=your_sepay_api_key_here
SEPAY_BANK_NAME=MBBank
SEPAY_ACCOUNT_NUMBER=0388888888
SEPAY_ACCOUNT_NAME=DGP ELECTRIC

# Download ad gate: first file, then every five downloaded files.
AD_ENABLED=true
AD_FREQUENCY=5
GOOGLE_ADSENSE_CLIENT_ID=ca-pub-1297862358247325
GOOGLE_ADSENSE_SLOT_ID=
